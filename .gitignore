
## `.gitignore`

```gitignore
# macOS
.DS_Store
.AppleDouble
.LSOverride

# VS Code
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# Logs
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Environment files
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Python
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd
.Python
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.tox/
.nox/

# Python virtual environments
venv/
backend/venv/
.env/
.venv/

# Flask / SQLite local database
backend/instance/
*.db
*.sqlite
*.sqlite3

# Node / frontend dependencies
node_modules/
frontend/node_modules/

# Frontend builds
dist/
frontend/dist/

# Package manager caches
.npm/
.pnpm-store/
.yarn/
.yarn-cache/

# TypeScript
*.tsbuildinfo

# Vite
.vite/

# Coverage
coverage/
frontend/coverage/

# Temporary files
tmp/
temp/
*.tmp
*.swp
*.swo

# OS / editor noise
.idea/
*.iml

# Zip files / local archives
*.zip
*.tar
*.tar.gz

# Do not commit generated cache folders
.cache/
.parcel-cache/

# Local database backups
*.bak
*.backup